# Sanity project. These two are public and safe to commit.
NEXT_PUBLIC_SANITY_PROJECT_ID=e72p6sym
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity robot token, Developer access level.
# Create at https://www.sanity.io/manage under the project's API tab.
# Server side only. Never expose this to the browser.
SANITY_API_TOKEN=

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Sanity Context MCP. Variable names are provisional until the day 2 spike
# confirms the real endpoint shape.
SANITY_CONTEXT_MCP_URL=
SANITY_CONTEXT_MCP_TOKEN=
