# Sanity project. These two are public and safe to commit.
NEXT_PUBLIC_SANITY_PROJECT_ID=e72p6sym
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity robot token, Developer access level.
# Create at https://www.sanity.io/manage under the project's API tab.
# Server side only. Never expose this to the browser.
SANITY_API_TOKEN=

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Sanity Context MCP endpoint, Knowledge Base mode.
# Format: https://api.sanity.io/v1/context/organizations/{orgId}/mcp/{endpointName}
# Our organization id is oz38d6spw. The endpoint name is whatever you called the
# MCP in the Context app.
SANITY_CONTEXT_MCP_URL=

# Organization-level token with Context Viewer permission, created under
# Manage > API > Tokens at the ORGANIZATION level. A project-level token will
# not work here and fails with 403 contextGrantRequired.
# Leave both blank to run against local fixtures instead.
SANITY_ORGANIZATION_TOKEN=
